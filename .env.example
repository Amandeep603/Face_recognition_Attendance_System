# ==============================================================================
#  AI Face Recognition Attendance System - Environment Variables Configuration
# ==============================================================================

# ESP32-CAM MJPEG Video Stream URL (or 0 for local USB webcam)
CAMERA_URL=http://192.168.18.142:81/stream

# Web Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SERVER_DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-secret-key

# AI Recognition & Anti-Spoofing Hyperparameters
RECOGNITION_TOLERANCE=0.45
FRAME_SKIP=3
PROCESS_SCALE=0.5
DETECTION_MODEL=hog
ANTI_SPOOFING_ENABLED=True

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
